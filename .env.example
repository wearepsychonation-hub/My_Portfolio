# Canonical site URL for metadata and the sitemap. On Vercel the production URL is used if unset.
NEXT_PUBLIC_SITE_URL=

# Leave the project ID empty to run on seed content (content/seed.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server-only. A Viewer token, needed only if the dataset is private.
SANITY_API_READ_TOKEN=
# Shared with the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
