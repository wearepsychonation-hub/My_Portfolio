    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "next-sanity": "^13.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^5.31.2",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
